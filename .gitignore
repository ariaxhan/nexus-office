node_modules/
.env*

# client/serve.py still serves dist/ if it is there. Nothing builds one today;
# the phone page lands here in milestone 2.
dist/

# the shot harness rewrites these on every run, and a screenshot in a repo is
# stale the day after it lands
shots/

# vault runtime state (agentdb, logs, chronicles) lives beside the code but never in it
_meta/

# generated by xcodegen from app/project.yml, which is the source of truth
app/*.xcodeproj
app/build/
