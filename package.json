{
  "name": "nexus-office",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "icon": "swift scripts/icon.swift",
    "bundle": "esbuild client/phone/office.js --bundle --format=esm --target=safari17 --outfile=client/phone/office-bundle.js",
    "pwa-probe": "node scripts/pwa-probe.mjs",
    "test": "scripts/test.sh",
    "shot": "scripts/shoot.sh",
    "complexity": "bash scripts/complexity.sh --check-baseline .complexity-baseline.tsv .",
    "verify": "npm run bundle && npm run complexity && npm test"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "playwright-core": "^1.62.1"
  }
}
