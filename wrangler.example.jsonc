{
  // Copy to wrangler.jsonc and fill in the database id, or just run
  // ./scripts/setup.sh which creates the database and writes this for you.
  //
  // account_id is deliberately absent: wrangler uses whatever account you are
  // logged into, or $CLOUDFLARE_ACCOUNT_ID. Pin it here only if you hold several
  // accounts and want the deploy target to be a fact rather than a default.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexus-office",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-25",
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexus-office",
      "database_id": "REPLACE_WITH_YOUR_D1_ID",
      "migrations_dir": "migrations"
    }
  ]
}
